# =============================================================================
# FarmVoice AI - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values before running the app.

# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-strong-random-secret-key

# MySQL Database Connection
# Update MYSQL_PASSWORD with your MySQL root (or app user) password.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password_here
MYSQL_DB=farmvoice_ai_db

# JWT Configuration
JWT_SECRET_KEY=replace-with-a-strong-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_TOKEN_LOCATION=cookies
JWT_ACCESS_COOKIE_NAME=access_token_cookie
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
JWT_ACCESS_CSRF_COOKIE_NAME=csrf_access_token
JWT_CSRF_METHODS=["POST", "PUT", "PATCH", "DELETE"]
JWT_CSRF_IN_COOKIES=True
JWT_CSRF_COOKIE_NAME=csrf_access_token_cookie
JWT_CSRF_COOKIE_SAMESITE=Lax
JWT_CSRF_COOKIE_SECURE=False
JWT_COOKIE_PATH=/api

# CORS
FRONTEND_URL=http://localhost:5173

# AI Assistant Multi-Provider Configuration
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

# Google Gemini (Primary Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq (Fallback Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Reliability & Fallback Policies
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT=30
AI_COOLDOWN_SECONDS=60
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1500

# Legacy compatibility (optional)
# AI_PROVIDER=gemini
# AI_API_KEY=your_api_key_here
# AI_MODEL=gemini-1.5-flash
# AI_TIMEOUT_SECONDS=30
# AI_BASE_URL=

# Sarvam AI Voice Integration (Regional Indian Speech-to-Text & Text-to-Speech)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_SPEECH_MODEL=saaras:v2
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_DEFAULT_SPEAKER=meera
