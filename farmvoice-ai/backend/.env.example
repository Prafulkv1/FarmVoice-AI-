# =============================================================================
# FarmVoice AI - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values before running the app.

# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-strong-random-secret-key

# MySQL Database Connection
# Update MYSQL_PASSWORD with your MySQL root (or app user) password.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password_here
MYSQL_DB=farmvoice_ai_db

# JWT Configuration
JWT_SECRET_KEY=replace-with-a-strong-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_TOKEN_LOCATION=cookies
JWT_ACCESS_COOKIE_NAME=access_token_cookie
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
JWT_ACCESS_CSRF_COOKIE_NAME=csrf_access_token
JWT_CSRF_METHODS=["POST", "PUT", "PATCH", "DELETE"]
JWT_CSRF_IN_COOKIES=True
JWT_CSRF_COOKIE_NAME=csrf_access_token_cookie
JWT_CSRF_COOKIE_SAMESITE=Lax
JWT_CSRF_COOKIE_SECURE=False
JWT_COOKIE_PATH=/api

# CORS
FRONTEND_URL=http://localhost:5173
